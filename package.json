{
  "name": "astronomy-lab",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node web/observatory/server.mjs",
    "check": "node tools/check.mjs",
    "test": "node tools/check.mjs --tests-only",
    "test:browser:legacy": "node tests/browser-review.mjs",
    "export:lectures": "conda run -n dl_env python tools/export-lectures.py --web --self-test",
    "build:lab": "node tools/build-lab.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "test:standalone": "node tests/standalone-refactor.mjs",
    "test:native-presets": "node tests/native-preset-precision.mjs",
    "build:deploy": "node tools/build-lab.mjs --out deploy/lab"
  },
  "description": "AstronomyLab R1 source repository: independent tools and separate original lecture assets"
}
